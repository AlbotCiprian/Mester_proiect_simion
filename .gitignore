# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
out/
.next/

# Environment / secrets
.env
.env.*
!.env.example
*.log
secrets/

# Claude local-only configuration
CLAUDE.local.md
.claude/settings.local.json

# Local Claude/Cowork temporary outputs
.cowork-temp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# TS incremental build info
*.tsbuildinfo

.vercel

# Never commit real environment files. .env.example holds NAMES ONLY and must
# stay tracked — the re-assertion is needed because the broad rule above would
# otherwise override the earlier negation.
.env*
!.env.example
