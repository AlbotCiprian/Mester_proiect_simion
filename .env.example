# Copy to .env.local for development, and set the same names in the Vercel
# project (Production scope only for the secrets — a Preview deployment must not
# be able to send mail).
#
# NEVER commit real values. Everything without the NEXT_PUBLIC_ prefix is
# server-only and must never be imported from a Client Component.

# --- Lead delivery (Resend) -------------------------------------------------
# Without all three, the form still renders and validates, but reports
# "undelivered" and hands the visitor the phone number instead of a fake
# confirmation. That is deliberate: there is no database to recover a lost lead.
RESEND_API_KEY=
# Must be an address on a domain VERIFIED in Resend, e.g. "SemiDom <contact@exemplu.md>"
LEAD_FROM_EMAIL=
# Where new requests land — the owner's inbox.
LEAD_TO_EMAIL=

# --- Anti-abuse -------------------------------------------------------------
# Any long random string. Keys the submit-idempotency fingerprint.
LEAD_FORM_SECRET=
# Any long random string. Hashes client IPs so a raw IP never sits in memory.
IP_HASH_SALT=
# Bump when the consent wording changes; stamped into every lead email.
LEAD_CONSENT_VERSION=2026-08-19

# --- Canonical host ---------------------------------------------------------
# Full origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://semidom.xelacktech.com
# The host the site is ALLOWED to be indexed under. Indexing stays off until
# this matches NEXT_PUBLIC_SITE_URL's host — see lib/seo.ts (INDEXABLE).
CONFIRMED_PRODUCTION_HOST=semidom.xelacktech.com
